# PromptXona — muhit o'zgaruvchilari
# Bu faylni `.env.local` nomi bilan nusxalab, qiymatlarni to'ldiring.
# HAMMASI IXTIYORIY: hech biri berilmasa ham sayt to'liq ishlaydi —
# faqat tizimga kirish o'chadi va progress brauzerda saqlanadi.

# --- Supabase (kirish + progressni bulutda saqlash) ---
# Supabase loyihangizda: Project Settings -> API bo'limidan oling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Prompt yuborish formasi (ixtiyoriy) ---
# Bo'sh bo'lsa ilova ichidagi /submit sahifasi ishlatiladi.
NEXT_PUBLIC_SUBMIT_FORM_URL=
